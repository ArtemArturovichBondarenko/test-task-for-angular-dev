{
  "name": "@app/weather",
  "version": "0.0.1",
  "peerDependencies": {
    "@angular/common": "^20.3.0",
    "@angular/core": "^20.3.0"
  },
  "sideEffects": false,
  "module": "esm2022/app-weather.js",
  "typings": "app-weather.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./app-weather.d.ts",
      "default": "./esm2022/app-weather.js"
    },
    "./state": {
      "types": "./state/index.d.ts",
      "default": "./fesm2022/app-weather-state.mjs"
    },
    "./ui": {
      "types": "./ui/index.d.ts",
      "default": "./fesm2022/app-weather-ui.mjs"
    }
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "scripts": {
    "prepublishOnly": "node --eval \"console.error('ERROR: Trying to publish a package that has been compiled in full compilation mode. This is not allowed.\\nPlease delete and rebuild the package with partial compilation mode, before attempting to publish.\\n')\" && exit 1"
  }
}